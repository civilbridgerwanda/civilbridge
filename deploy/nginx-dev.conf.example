# Nginx server block for CivilBridge DEVELOPMENT - dev.civil-bridge.com.
#
# Identical to nginx-prod.conf.example, just pointed at the dev checkout's
# web root and the dev backend's port, so dev and prod run side by side on
# the same server without colliding. This is what you test changes
# against before promoting the same commit to the prod checkout.
#
# Install:
#   sudo cp deploy/nginx-dev.conf.example /etc/nginx/conf.d/civilbridge-dev.conf
#   sudo nginx -t && sudo systemctl reload nginx
#
# Add an A record for dev.civil-bridge.com pointing at this same server's
# IP before requesting its own SSL cert (see README) - it's a separate
# hostname, so it needs its own certbot run:
#   sudo certbot --nginx -d dev.civil-bridge.com

server {
    listen 80;
    listen [::]:80;
    server_name dev.civil-bridge.com;

    # IMPORTANT: this is a SIBLING directory to the git checkout
    # (/var/www/civilbridge-dev), NOT .../civilbridge-dev/client. That
    # folder is source code (package.json, src/, node_modules) - pointing
    # Nginx's root at it, or having deploy.sh rsync into it, deletes the
    # entire source checkout (see deploy.sh's comment on WEB_ROOT for
    # exactly why, and README section 18 for recovery if this happens).
    root /var/www/civilbridge-dev-web;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Dev backend runs on a DIFFERENT port (5001) than prod (5000) - set
    # via PORT in the dev checkout's server/.env - so both PM2 processes
    # can run at the same time on this one server.
    location /api/ {
        proxy_pass http://127.0.0.1:5001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /socket.io/ {
        proxy_pass http://127.0.0.1:5001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    client_max_body_size 10M;

    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
