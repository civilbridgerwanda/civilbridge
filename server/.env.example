# Server
PORT=5000
CLIENT_URL=http://localhost:5173
# The server's own public URL - must exactly match what you register as
# the OAuth redirect/callback base with Google/Facebook/X below.
SERVER_URL=http://localhost:5000
# Used to sign the temporary session cookie during the OAuth handshake
# only (not your login sessions - those are JWTs). Any random string works.
SESSION_SECRET=replace_this_with_another_long_random_string

# MySQL (mysqli equivalent - using mysql2 driver, which is the modern
# Node.js driver for MySQL; works with any standard MySQL/MariaDB server)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=civilbridge

# JWT signing secret - used to sign/verify sign-in tokens (server/src/middleware/auth.js)
JWT_SECRET=replace_this_with_a_long_random_string

# Email (Nodemailer) - used for welcome emails, estimate status updates,
# and newsletter confirmations. Any SMTP provider works (Gmail app password,
# SendGrid, Mailgun, Amazon SES, etc.)
#
# Gmail example (requires 2-Step Verification + an App Password, not your
# regular password - generate one at https://myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=abcdefghijklmnop   (the app password with spaces removed)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
FROM_EMAIL="CivilBridge <no-reply@civil-bridge.com>"
# Who is emailed whenever a client submits a payment that needs verifying
# (one address, or several separated by commas - e.g. your finance person).
# If unset, the alert goes to every admin account's email instead. Needs the
# SMTP settings above to actually deliver.
FINANCE_EMAIL=

# Where contact form submissions get sent. Defaults to SMTP_USER if unset.
CONTACT_EMAIL=

# Cloudinary - used for image uploads (property photos, expert avatars,
# uploaded plan files). Get these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Payments - no gateway connected yet (see server/src/config/paymentProvider.js
# for what to do when you're ready). Flutterwave is the practical choice for
# Rwanda (cards + MTN/Airtel Mobile Money).
FLUTTERWAVE_SECRET_KEY=

# Social sign-in (Google, Facebook, X). Each is entirely optional - leave a
# provider's variables blank/unset and that button will redirect back to
# sign-in with a clear "not configured" message instead of erroring.
# See README section 15 for exact setup steps for each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=
