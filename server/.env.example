# Server
PORT=5000
CLIENT_URL=http://localhost:5173
# The server's own public URL - must exactly match what you register as
# the OAuth redirect/callback base with Google/Facebook/X below.
SERVER_URL=http://localhost:5000
# Used to sign the temporary session cookie during the OAuth handshake
# only (not your login sessions - those are JWTs). Any random string works.
SESSION_SECRET=replace_this_with_another_long_random_string

# MySQL (mysqli equivalent - using mysql2 driver, which is the modern
# Node.js driver for MySQL; works with any standard MySQL/MariaDB server)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=civilbridge

# JWT signing secret - used to sign/verify sign-in tokens (server/src/middleware/auth.js)
JWT_SECRET=replace_this_with_a_long_random_string

# Email (Nodemailer) - used for welcome emails, estimate status updates,
# and newsletter confirmations. Any SMTP provider works (Gmail app password,
# SendGrid, Mailgun, Amazon SES, etc.)
#
# Gmail example (requires 2-Step Verification + an App Password, not your
# regular password - generate one at https://myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=abcdefghijklmnop   (the app password with spaces removed)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
FROM_EMAIL="CivilBridge <no-reply@civil-bridge.com>"
# Who is emailed whenever a client submits a payment that needs verifying
# (one address, or several separated by commas - e.g. your finance person).
# If unset, the alert goes to every admin account's email instead. Needs the
# SMTP settings above to actually deliver.
FINANCE_EMAIL=

# Who is emailed when a piece of work needs the team to hand it to an expert
# (a new estimate needing analysis, or an analysis that just finished/failed).
# One address, or several separated by commas. If unset, every admin account's
# email is used. In-app notifications go to all admins either way.
OPS_EMAIL=

# A site tour the team has CONFIRMED completes on its own this many hours after
# its scheduled time, which is what lets the visitor review the property.
# 0 = never auto-complete (an admin must mark every tour by hand).
TOUR_AUTO_COMPLETE_HOURS=24

# Where contact form submissions get sent. Defaults to SMTP_USER if unset.
CONTACT_EMAIL=

# Cloudinary - used for image uploads (property photos, expert avatars,
# uploaded plan files). Get these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---------------------------------------------------------------------------
# AI agent + chat - API keys are stored here and stay IDLE until you flip the
# switch. Nothing is called while the switch is off, whatever keys are set.
# Full contract and setup steps: docs/N8N_AGENT_INTEGRATION.md
# ---------------------------------------------------------------------------

# Layer 2 - the heavy-duty agent (cost estimation, 2D/3D + CAD drawing sets,
# pricing-database lookups). "n8n" today; a proprietary model can replace it
# later without touching the rest of the app (AGENT_PROVIDER=<new provider>).
AGENT_ENABLED=false
AGENT_PROVIDER=n8n
# The n8n Webhook node's production URL (https://your-n8n-host/webhook/...).
N8N_WEBHOOK_URL=
# Shared secret we send to n8n on every request (an HTTP header) so the
# workflow can reject anything that isn't us. Any long random string; put the
# same value in the n8n Webhook node's Header Auth credential.
N8N_WEBHOOK_SECRET=
# Shared secret n8n uses to sign its replies to us (HMAC-SHA256 of the request
# body). Different value from the one above. Replies with a bad signature are
# rejected.
N8N_CALLBACK_SECRET=
N8N_TIMEOUT_MS=15000

# Layer 1 - the lightweight chat model for everyday questions. "rules" is the
# built-in responder (no key, always available). Set CHAT_PROVIDER=llm and a
# key to answer with a real language model instead; if the call ever fails it
# falls back to the built-in responder.
CHAT_PROVIDER=rules
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=claude-haiku-4-5-20251001
CHAT_LLM_BASE_URL=https://api.anthropic.com

# Payments - no gateway connected yet (see server/src/config/paymentProvider.js
# for what to do when you're ready). Flutterwave is the practical choice for
# Rwanda (cards + MTN/Airtel Mobile Money).
FLUTTERWAVE_SECRET_KEY=

# Social sign-in (Google, Facebook, X). Each is entirely optional - leave a
# provider's variables blank/unset and that button will redirect back to
# sign-in with a clear "not configured" message instead of erroring.
# See README section 15 for exact setup steps for each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=
