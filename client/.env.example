# Backend API
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Google Tag Manager container ID (e.g. GTM-XXXXXXX)
# GA4 itself should be added as a tag *inside* GTM, not hardcoded separately -
# that's the current recommended setup, and it means you can add/remove
# tracking (GA4, Ads conversion tags, etc.) later without touching code.
VITE_GTM_ID=GTM-XXXXXXX

# Google Search Console HTML verification meta tag content
VITE_GSC_VERIFICATION=your_verification_string_here
